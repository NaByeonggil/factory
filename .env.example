# ─── Database ───────────────────────────────────────────────
# 로컬:  postgresql://dev:devpass@localhost:5432/factory?schema=public
# Neon:  postgresql://USER:PASS@ep-xxx.ap-southeast-1.aws.neon.tech/factory?sslmode=require
DATABASE_URL="postgresql://dev:devpass@localhost:5432/factory?schema=public"

# ─── Site ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Admin auth ─────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET="change-me-to-a-32-byte-random-string"

# IP 해시용 솔트 (개인정보 최소수집)
IP_HASH_SALT="change-me"

# ─── 문의 접수 알림 ──────────────────────────────────────────
# Resend (https://resend.com) — 없으면 콘솔에만 출력
RESEND_API_KEY=""
NOTIFY_FROM="noreply@example.com"
NOTIFY_TO="sales@example.com,manager@example.com"

# 카카오 알림톡 (솔라피) — 선택
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
SOLAPI_PFID=""
SOLAPI_TEMPLATE_ID=""
SOLAPI_SENDER=""
NOTIFY_SMS_TO=""

# ─── 파일 저장소 ────────────────────────────────────────────
# local 만 구현됨. Vercel Blob / R2 는 src/lib/storage/ 에 드라이버 추가.
STORAGE_DRIVER="local"
# 운영에서는 앱 폴더 밖의 절대경로로 두세요.
# 배포할 때 앱 디렉터리를 갈아끼우면 올린 이미지가 함께 날아갑니다.
UPLOAD_DIR="./storage/uploads"

# ─── 백업 (scripts/backup.sh) ────────────────────────────────
BACKUP_DIR="./backups"
# 보관 일수
BACKUP_KEEP="14"
# 도커로 띄운 Postgres 라면 컨테이너 이름 (직접 설치했다면 비워두세요)
PG_DOCKER=""

# ─── 스팸 방지 (Cloudflare Turnstile) ────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── 광고/분석 태그 ──────────────────────────────────────────
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_NAVER_CONVERSION_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# ─── 견적·원가 시스템(datahealth) 연동 ───────────────────────
# 두 앱이 서로를 확인하는 공유 비밀키. datahealth 의 .env 와 같은 값이어야 합니다.
# openssl rand -hex 32  — 비워두면 연동(문의 AI 분석, 자동 로그인)이 꺼집니다.
INTEGRATION_SECRET=
# 서버끼리 부르는 내부 주소 / 브라우저를 보내는 공개 주소
DATAHEALTH_INTERNAL_URL=http://datahealth-app:3000
DATAHEALTH_PUBLIC_URL=https://data.cancerwith.kr

# ─── AI 견적 연동 ───────────────────────────────────────────
# AI 견적 서버가 POST /api/integration/ai-quote 로 글을 올릴 때 쓰는 Bearer 키.
# AI 견적의 FACTORY_BOARD_KEY 와 같은 값. openssl rand -hex 32 — 비워두면 꺼집니다.
AI_QUOTE_KEY=
