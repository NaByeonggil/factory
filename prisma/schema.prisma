// 건강기능식품 OEM/ODM 기업 사이트 — Prisma schema
// 문서: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── enums ─────────────────────────

enum Locale {
  KO
  EN
  ZH
}

/// 제공 서비스 구분
enum ServiceType {
  OEM /// 완제품 위탁생산
  ODM /// 개발생산
  CDMO /// 의약외품 위탁개발생산
  DTC /// 개인맞춤형 건기식(유전자검사 연계)
  PET /// 반려동물 제품
}

/// 보유 원료 분류
enum IngredientCategory {
  INDIVIDUAL_APPROVED /// 개별인정형
  PATENT /// 특허보유
  BASIC /// 기본(고시형)
  HOT_TREND /// HOT 트렌드
  SUPERFOOD /// 슈퍼푸드
}

/// 생산문의 처리 단계
enum InquiryStatus {
  NEW /// 접수
  CONTACTED /// 상담중
  QUOTED /// 견적발송
  CONTRACTED /// 계약
  CLOSED /// 종료
  SPAM /// 스팸
}

enum PostCategory {
  NEWS /// 소식
  NOTICE /// 공지
  ESG /// ESG 경영
  FACTORY_TOUR /// 공장 투어
}

enum Role {
  ADMIN
  EDITOR
  SALES
}

// ──────────────────── 전환 핵심: 생산문의 ────────────────────

model Inquiry {
  id String @id @default(cuid())

  // 신청자
  name    String
  company String?
  phone   String
  email   String?

  // 문의 내용
  serviceType  ServiceType @default(OEM)
  formulations String[] /// 제형 코드 배열 (src/lib/constants.ts)
  packagings   String[] /// 포장방식 코드 배열
  quantity     String? /// 예상 수량 구간 코드
  budget       String? /// 예산 구간 코드
  targetDate   DateTime? /// 희망 납기
  message      String?     @db.Text

  // 동의 (개인정보보호법)
  privacyAgreedAt DateTime
  marketingAgreed Boolean  @default(false)

  // 광고 유입 추적 — 키워드별 전환 분석용
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  naverKeyword String? /// n_keyword
  naverRank    String? /// n_rank
  naverAdGroup String? /// n_ad_group
  landingPath  String?
  referrer     String?
  rawParams    Json? /// 유입 쿼리스트링 원본 전체

  // 운영
  status     InquiryStatus @default(NEW)
  assigneeId String?
  assignee   User?         @relation("InquiryAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  files      InquiryFile[]
  memos      InquiryMemo[]

  // 최소 수집 원칙: IP는 원문 대신 해시 보관
  ipHash    String?
  userAgent String?
  locale    Locale   @default(KO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([utmSource, naverKeyword])
  @@index([assigneeId])
}

model InquiryFile {
  id         String  @id @default(cuid())
  inquiryId  String
  inquiry    Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  /// 스토리지 드라이버 내부 키 (로컬: storage/uploads 하위 상대경로)
  storageKey String  @unique
  /// 다운로드 주소. 로컬 드라이버는 관리자 인증이 걸린 /api/files/<key>
  url        String
  filename   String
  size       Int
  mimeType   String

  createdAt DateTime @default(now())

  @@index([inquiryId])
}

model InquiryMemo {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([inquiryId, createdAt])
}

// ───────────────────────── 콘텐츠 ─────────────────────────

model Ingredient {
  id           String             @id @default(cuid())
  slug         String             @unique
  category     IngredientCategory
  thumbnailUrl String?
  isFeatured   Boolean            @default(false) /// 메인 노출 여부
  isPublished  Boolean            @default(true)
  sortOrder    Int                @default(0)

  translations IngredientTranslation[]
  products     Product[]               @relation("ProductIngredients")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, isPublished, sortOrder])
  @@index([isFeatured, sortOrder])
}

model IngredientTranslation {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  locale       Locale

  name          String /// 멜라토닌 / NMN / IB Complex …
  summary       String?
  functionality String? @db.Text /// 기능성 내용
  dailyDose     String? /// 일일섭취량
  body          String? @db.Text
  seoTitle      String?
  seoDesc       String?

  @@unique([ingredientId, locale])
  @@index([locale])
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  serviceType ServiceType
  formulation String /// 제형 코드
  imageUrls   String[]
  isPublished Boolean     @default(true)
  isFeatured  Boolean     @default(false)
  sortOrder   Int         @default(0)

  ingredients  Ingredient[]         @relation("ProductIngredients")
  translations ProductTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model ProductTranslation {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale    Locale

  title       String
  description String? @db.Text
  seoTitle    String?
  seoDesc     String?

  @@unique([productId, locale])
}

model Post {
  id          String       @id @default(cuid())
  slug        String       @unique
  category    PostCategory
  coverUrl    String?
  publishedAt DateTime?
  viewCount   Int          @default(0)

  translations PostTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, publishedAt])
}

model PostTranslation {
  id       String  @id @default(cuid())
  postId   String
  post     Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  locale   Locale
  title    String
  excerpt  String?
  body     String  @db.Text
  seoTitle String?
  seoDesc  String?

  @@unique([postId, locale])
}

/// GMP, HACCP, ISO 9001/14001/22000/45001/50001, CCM …
model Certification {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  issuer    String?
  imageUrl  String?
  issuedAt  DateTime?
  sortOrder Int       @default(0)
}

/// 대표번호·주소·사업자번호·메인 카피 등 운영자가 바꾸는 값
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ───────────────────────── 운영자 ─────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  role         Role    @default(SALES)
  isActive     Boolean @default(true)

  assignedInquiries Inquiry[]     @relation("InquiryAssignee")
  memos             InquiryMemo[]

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
