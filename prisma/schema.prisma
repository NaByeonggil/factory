// 건강기능식품 OEM/ODM 기업 사이트 — Prisma schema
// 문서: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── enums ─────────────────────────

enum Locale {
  KO
  EN
  ZH
}

/// 제공 서비스 구분
enum ServiceType {
  OEM /// 완제품 위탁생산
  ODM /// 개발생산
  CDMO /// 의약외품 위탁개발생산
  DTC /// 개인맞춤형 건기식(유전자검사 연계)
  PET /// 반려동물 제품
}

/// 보유 원료 분류
enum IngredientCategory {
  INDIVIDUAL_APPROVED /// 개별인정형
  PATENT /// 특허보유
  BASIC /// 기본(고시형)
  HOT_TREND /// HOT 트렌드
  SUPERFOOD /// 슈퍼푸드
}

/// 생산문의 처리 단계
enum InquiryStatus {
  NEW /// 접수
  CONTACTED /// 상담중
  QUOTED /// 견적발송
  CONTRACTED /// 계약
  CLOSED /// 종료
  SPAM /// 스팸
}

/// 견적문의 답글 작성 주체
enum ReplyAuthor {
  CUSTOMER /// 문의한 고객 (비밀번호로 본인 확인)
  ADMIN /// 운영자
}

enum PostCategory {
  NEWS /// 소식
  NOTICE /// 공지
  ESG /// ESG 경영
  FACTORY_TOUR /// 공장 투어
}

enum Role {
  ADMIN
  EDITOR
  SALES
}

// ──────────────────── 전환 핵심: 생산문의 ────────────────────

model Inquiry {
  id String @id @default(cuid())

  // 신청자
  name    String
  company String?
  phone   String
  email   String?

  // 문의 내용
  /// 견적문의 게시판에 노출되는 제목. 비우면 서비스 유형으로 자동 생성합니다
  title        String?
  serviceType  ServiceType @default(OEM)
  formulations String[] /// 제형 코드 배열 (src/lib/constants.ts)
  packagings   String[] /// 포장방식 코드 배열
  quantity     String? /// 예상 수량 구간 코드
  budget       String? /// 예산 구간 코드
  targetDate   DateTime? /// 희망 납기
  message      String?     @db.Text

  // 동의 (개인정보보호법)
  privacyAgreedAt DateTime
  marketingAgreed Boolean  @default(false)

  // 광고 유입 추적 — 키워드별 전환 분석용
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  naverKeyword String? /// n_keyword
  naverRank    String? /// n_rank
  naverAdGroup String? /// n_ad_group
  landingPath  String?
  referrer     String?
  rawParams    Json? /// 유입 쿼리스트링 원본 전체

  // 운영
  status     InquiryStatus @default(NEW)
  assigneeId String?
  assignee   User?         @relation("InquiryAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  files      InquiryFile[]
  memos      InquiryMemo[]
  replies    InquiryReply[]

  // 견적문의 게시판 — 고객이 본인 문의와 답변을 확인하는 경로
  /// 본인 확인용 비밀번호 해시. 게시판 도입 전 문의는 비어 있습니다
  passwordHash String?
  /// 고객에게 공개되는 답변 (내부 상담 메모와 구분)
  replyBody    String?   @db.Text
  repliedAt    DateTime?
  repliedById  String?
  repliedBy    User?     @relation("InquiryReplier", fields: [repliedById], references: [id], onDelete: SetNull)

  // 최소 수집 원칙: IP는 원문 대신 해시 보관
  ipHash    String?
  userAgent String?
  locale    Locale   @default(KO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([utmSource, naverKeyword])
  @@index([assigneeId])
  @@index([repliedById])
}

model InquiryFile {
  id         String  @id @default(cuid())
  inquiryId  String
  inquiry    Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  /// 스토리지 드라이버 내부 키 (로컬: storage/uploads 하위 상대경로)
  storageKey String  @unique
  /// 다운로드 주소. 로컬 드라이버는 관리자 인증이 걸린 /api/files/<key>
  url        String
  filename   String
  size       Int
  mimeType   String

  createdAt DateTime @default(now())

  @@index([inquiryId])
}

model InquiryMemo {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([inquiryId, createdAt])
}

/// 견적문의 게시판의 답글 스레드 (고객 ↔ 운영자)
model InquiryReply {
  id        String  @id @default(cuid())
  inquiryId String
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  authorType ReplyAuthor
  /// 운영자 답글이면 작성자 계정
  authorId   String?
  author     User?       @relation("InquiryReplyAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// 화면에 표시할 이름 (고객은 문의자 이름, 운영자는 담당자 이름)
  authorName String

  body  String             @db.Text
  files InquiryReplyFile[]

  // 최소 수집 원칙: IP는 원문 대신 해시 보관
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([inquiryId, createdAt])
  @@index([authorId])
}

/// 답글 첨부 (견적서 PDF 등). 열람 권한은 답글이 달린 문의를 따릅니다
model InquiryReplyFile {
  id      String       @id @default(cuid())
  replyId String
  reply   InquiryReply @relation(fields: [replyId], references: [id], onDelete: Cascade)

  /// 스토리지 드라이버 내부 키 (로컬: storage/uploads 하위 상대경로)
  storageKey String @unique
  filename   String
  size       Int
  mimeType   String

  createdAt DateTime @default(now())

  @@index([replyId])
}

// ───────────────────────── 콘텐츠 ─────────────────────────

model Ingredient {
  id           String             @id @default(cuid())
  slug         String             @unique
  category     IngredientCategory
  thumbnailUrl String?
  isFeatured   Boolean            @default(false) /// 메인 노출 여부
  isPublished  Boolean            @default(true)
  sortOrder    Int                @default(0)

  translations IngredientTranslation[]
  products     Product[]               @relation("ProductIngredients")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, isPublished, sortOrder])
  @@index([isFeatured, sortOrder])
}

model IngredientTranslation {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  locale       Locale

  name          String /// 멜라토닌 / NMN / IB Complex …
  summary       String?
  functionality String? @db.Text /// 기능성 내용
  dailyDose     String? /// 일일섭취량
  body          String? @db.Text
  seoTitle      String?
  seoDesc       String?

  @@unique([ingredientId, locale])
  @@index([locale])
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  serviceType ServiceType
  formulation String /// 제형 코드
  imageUrls   String[]
  isPublished Boolean     @default(true)
  isFeatured  Boolean     @default(false)
  sortOrder   Int         @default(0)

  ingredients  Ingredient[]         @relation("ProductIngredients")
  translations ProductTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model ProductTranslation {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale    Locale

  title       String
  description String? @db.Text
  seoTitle    String?
  seoDesc     String?

  @@unique([productId, locale])
}

model Post {
  id          String       @id @default(cuid())
  slug        String       @unique
  category    PostCategory
  coverUrl    String?
  publishedAt DateTime?
  viewCount   Int          @default(0)

  translations PostTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, publishedAt])
}

model PostTranslation {
  id       String  @id @default(cuid())
  postId   String
  post     Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  locale   Locale
  title    String
  excerpt  String?
  body     String  @db.Text
  seoTitle String?
  seoDesc  String?

  @@unique([postId, locale])
}

// ─────────────────────── 문답 게시판 ───────────────────────

/// 고객이 직접 남기는 공개 질문과 운영자 답변 (1:1 생산문의와 별개)
model Question {
  id String @id @default(cuid())

  // 작성자 — 목록·상세에는 마스킹해서 노출합니다
  authorName String
  company    String?
  email      String?
  phone      String?

  /// 비밀글 열람·본인 확인용 비밀번호 해시 (bcrypt)
  passwordHash String
  /// 비밀글이면 제목만 공개하고 내용·답변은 비밀번호로 잠급니다
  isSecret     Boolean @default(false)

  title String
  body  String @db.Text

  // 운영자 답변
  answerBody   String?   @db.Text
  answeredAt   DateTime?
  answeredById String?
  answeredBy   User?     @relation("QuestionAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)

  /// 스팸·부적절 글 숨김 (삭제 대신)
  isPublished Boolean @default(true)
  viewCount   Int     @default(0)

  // 최소 수집 원칙: IP는 원문 대신 해시 보관
  ipHash    String?
  userAgent String?
  locale    Locale   @default(KO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locale, isPublished, createdAt])
  @@index([answeredAt])
}

// ─────────────────────── 팝업 공지 ───────────────────────

/// 사이트 진입 시 뜨는 팝업 공지. 핸드폰 화면 규격(320×480) 고정입니다.
model Popup {
  id       String  @id @default(cuid())
  slug     String  @unique
  imageUrl String? /// 팝업 본문 이미지 (권장 640×800, 4:5)
  linkUrl  String? /// 클릭 시 이동 주소. 비우면 이동하지 않습니다

  /// 노출 기간. 비우면 제한 없음
  startsAt DateTime?
  endsAt   DateTime?

  isPublished Boolean @default(false)
  sortOrder   Int     @default(0)

  translations PopupTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model PopupTranslation {
  id      String @id @default(cuid())
  popupId String
  popup   Popup  @relation(fields: [popupId], references: [id], onDelete: Cascade)
  locale  Locale

  title     String
  body      String? @db.Text
  linkLabel String? /// 버튼 문구 (예: 자세히 보기)

  @@unique([popupId, locale])
}

/// GMP, HACCP, ISO 9001/14001/22000/45001/50001, CCM …
model Certification {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  issuer    String?
  imageUrl  String?
  issuedAt  DateTime?
  sortOrder Int       @default(0)
}

/// 대표번호·주소·사업자번호·메인 카피 등 운영자가 바꾸는 값
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ───────────────────────── 운영자 ─────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  role         Role    @default(SALES)
  isActive     Boolean @default(true)

  assignedInquiries Inquiry[]     @relation("InquiryAssignee")
  repliedInquiries  Inquiry[]     @relation("InquiryReplier")
  memos             InquiryMemo[]
  inquiryReplies    InquiryReply[] @relation("InquiryReplyAuthor")
  answeredQuestions Question[]     @relation("QuestionAnswerer")

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
