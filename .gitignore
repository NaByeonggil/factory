# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 필요한 환경변수 목록은 커밋합니다 (값은 전부 placeholder)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# 업로드된 첨부파일 (로컬 스토리지 드라이버)
/storage

# 백업 산출물 (DB 덤프·업로드 파일 묶음)
/backups

# prisma init 이 내려받는 AI 에이전트 스킬 문서 (재생성 가능)
/.agents
/.claude
/.windsurf
/skills-lock.json
